# Connection string do Supabase (Project Settings > Database > Connection string
# > JDBC, modo "Session pooler" — ver README.md, seção "Configurando o Supabase").
# Formato: jdbc:postgresql://<host-do-pooler>:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://troque-para-o-host-do-seu-projeto.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.troque-para-o-ref-do-seu-projeto
SPRING_DATASOURCE_PASSWORD=troque-para-a-senha-do-banco
